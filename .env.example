# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# URL of your deployed backend API (Vercel)
# Local dev: http://localhost:3001/api  (or 3003 if you changed it)
# Production: https://your-backend.vercel.app/api
VITE_API_URL="https://your-backend.vercel.app/api"

# Firebase config (from Firebase Console → Project Settings → Your Apps)
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"

# ── Backend (server/) ─────────────────────────────────────────────────────────
# Set this in Vercel Dashboard → Project → Environment Variables
OPENAI_API_KEY="sk-..."
# Defaults to gpt-5.5. Override this only with a model available to your API project.
OPENAI_MODEL="gpt-5.5"
# Optional display-only rates used by the frontend usage dashboard.
VITE_OPENAI_INPUT_COST_PER_MILLION="0"
VITE_OPENAI_OUTPUT_COST_PER_MILLION="0"

# -- Daily automation (Vercel server environment) -------------------------
# Vercel calls cron endpoints with this value as: Authorization: Bearer <secret>
CRON_SECRET="generate-a-long-random-secret"
FIREBASE_PROJECT_ID="your-project-id"
# One-line JSON service account. Never expose this as a VITE_ variable.
FIREBASE_SERVICE_ACCOUNT='{"project_id":"your-project-id","client_email":"firebase-adminsdk@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}'
AUTOMATION_OWNER_UID="firebase-user-uid-that-owns-automated-leads"
AUTOMATION_TARGETS='[{"location":"Bengaluru, India","keyword":"Dental Clinics","radius":5,"maxResults":10}]'
REPORT_TIMEZONE="Asia/Kolkata"
DASHBOARD_URL="https://your-app.example.com"

# Google Workspace SMTP: authenticate as the primary mailbox, send as its alias.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="admin@reliablefocus.com"
# Google app password for SMTP_USER (requires 2-Step Verification and policy support).
SMTP_PASS=""
OUTREACH_EMAIL_FROM="sales@reliablefocus.com"
EMAIL_REPLY_TO="sales@reliablefocus.com"
REPORT_EMAIL_FROM="sales@reliablefocus.com"
REPORT_EMAIL_TO="admin@reliablefocus.com"

# WhatsApp Business Cloud API. Create an approved daily_lead_report template
# with one body variable, then opt the destination number into these reports.
WHATSAPP_ACCESS_TOKEN="your-system-user-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_REPORT_TO="919999999999"
WHATSAPP_TEMPLATE_NAME="daily_lead_report"
WHATSAPP_TEMPLATE_LANGUAGE="en_US"
WHATSAPP_GRAPH_VERSION="v23.0"

# Telegram internal reports and review-queue link
TELEGRAM_BOT_TOKEN="123456:bot-token"
TELEGRAM_CHAT_ID="your-chat-id"
